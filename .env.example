# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Datastores ────────────────────────────────────────────────────────────────
# `?replicaSet=rs0` matters: multi-document transactions need a replica set.
MONGO_URI=mongodb://localhost:27017/task_management?replicaSet=rs0
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (minimum 32 characters each)
# Two distinct secrets, so a leaked access secret cannot mint refresh tokens.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_SECONDS=604800

# ── Caching & CORS ────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300
CORS_ORIGINS=*

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_WRITE_MAX=20
